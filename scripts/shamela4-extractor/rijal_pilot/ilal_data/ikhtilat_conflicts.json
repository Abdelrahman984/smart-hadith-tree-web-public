  {
   "type": "text_discrepancy",
   "narrator": "سعيد بن إياس أبو مسعود الجريري",
   "narrator_id": 24,
   "entry": "25846:main:16",
   "detail": "النص: 'أبو أحمد بن عدي' (لا أكذب الله سمعنا ... وهو مختلط) والمحقق يصوبه إلى محمد بن أبي عدي (توفي 194) بحسب الكامل؛ وفي الكواكب (309) 'ابن عدى' أيضا. أي أن هذا التلميذ سمع بعد الاختلاط."
  },
  {
   "type": "text_discrepancy",
   "narrator": "محمد بن الفضل أبو النعمان السدوسي الحافظ عارم",
   "narrator_id": 52,
   "entry": "25846:main:41",
   "detail": "أبو داود: 'استحكم به الاختلاط سنة ست وعشرين ومائتين' في 25846، بينما عارم توفي 224 والكواكب (309) تقول 'سنة ست عشرة': الأرجح خطأ نسخ والصحيح 216."
  },
  {
   "type": "text_discrepancy",
   "narrator": "سفيان بن عيينة بن أبي عمران واسمه ميمون",
   "narrator_id": 27,
   "entry": "25846:main:19",
   "detail": "النص يقول 'اختلط سنة سبع وستين' والصواب سبع وتسعين (197)؛ القطان مات 198 والكواكب (309) تقول 197."
  },
  {
   "type": "text_discrepancy",
   "narrator": "عبد الباقي بن قانع أبو الحسين الحافظ مصنف المعجم في الصحابة",
   "narrator_id": 45,
   "entry": "25846:main:27",
   "detail": "وفاة ابن قانع: حاشية المخطوط 'سنة إحدى وثمانين وثلاثمائة' والمعروف 351 (الكواكب: لم تذكر السنة)؛ والمحقق ينبه أن 'ابن الفراء' في المخطوط تصحيف 'ابن الفرات'."
  },
  {
   "type": "text_discrepancy",
   "narrator": "عبد الله بن لهيعة بن عقبة الحضرمي أبو عبد الرحمن المصري القاضي",
   "narrator_id": 108,
   "entry": "309:appendix1:25",
   "detail": "تعليق المحقق (١): ابن معين نفى احتراق كتب ابن لهيعة ('ليس لهذا أصل، سألت عنها بمصر') وقال: ابن لهيعة ليس بشيء تغير أو لم يتغير؛ ومع ذلك استنبط المحقق أن الثوري وشعبة والأوزاعي وعمرو بن الحارث رووا عنه قبل احتراق كتبه سنة 169. وفي 25846 يروي عثمان بن صالح السهمي أن كتبه لم تحترق كلها."
  },
  {
   "type": "text_discrepancy",
   "narrator": "محمد بن موسى بن محمد اللخمي الشافعي بن سند الحافظ شمس الدين",
   "narrator_id": 63,
   "entry": "309:main:63",
   "detail": "المؤلف (ابن الكيال) ينبه على أنه حذف مسلم بن كيسان من الباب الرئيسي مع صحة اختلاطه، ثم أضافه المحقق في الملحق الثاني؛ لا يرد في 25846 سوى ملحق (ز) رقم 119."
  }
 ]
